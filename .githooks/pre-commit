#!/bin/sh
# Pre-commit hook: block commits that ADD files under node_modules/.
#
# Note: node_modules/ was removed from the git index (see .gitignore).
# Earlier versions of this hook "unstaged" every node_modules file, which
# would have silently sabotaged that cleanup commit. Now we only reject
# newly added (A) node_modules files and let deletions pass through.

# Newly added files under node_modules/ (NUL-safe, diff-filter=A = added)
ADDED=$(git diff --cached --name-only --diff-filter=A -z | tr '\0' '\n' | grep -E '^node_modules/' || true)

if [ -n "$ADDED" ]; then
  echo "pre-commit: ERROR - berkas berikut tidak boleh di-commit:" >&2
  echo "$ADDED" | sed 's/^/  - /' >&2
  echo "" >&2
  echo "node_modules/ sudah di-ignore (.gitignore). Jalankan: git rm --cached <file>" >&2
  exit 1
fi

exit 0
